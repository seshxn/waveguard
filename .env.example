# Database Configuration
POSTGRES_USER=waveguard
POSTGRES_PASSWORD=waveguard
POSTGRES_DB=waveguard
DATABASE_URL=postgresql://waveguard:waveguard@waveguard-db:5432/waveguard

# Backend Configuration
BACKEND_PORT=8000
WAVEGUARD_ARMED_DEFAULT=true
WAVEGUARD_Z_THRESHOLD=2.5
WAVEGUARD_DEBOUNCE_SECONDS=10
WAVEGUARD_MIN_TRIGGER_SAMPLES=3
WAVEGUARD_WINDOW_SECONDS=60

# Collector Configuration
WAVEGUARD_ROUTER_ID=home-router-1
WAVEGUARD_TRACKED_MACS=AA:BB:CC:DD:EE:FF,11:22:33:44:55:66
WAVEGUARD_COLLECTION_INTERVAL_SECONDS=1
WAVEGUARD_BACKEND_URL=http://waveguard-backend:8000
# Provider type: 'iw' (Linux Wi-Fi) or 'stub' (Testing)
WAVEGUARD_METRIC_PROVIDER=stub

# Frontend Configuration
FRONTEND_PORT=3000

# Telegram Notification (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
